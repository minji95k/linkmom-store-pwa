# Supabase — 프로젝트 설정 > API 에서 확인 (신규 API Key 체계: Publishable/Secret Key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용. 절대 NEXT_PUBLIC_ 접두사를 붙이거나 클라이언트 번들에 노출하지 않는다 (CLAUDE.md 절대 원칙 12)
SUPABASE_SECRET_KEY=
# 서버 전용, migration 적용(scripts/migrate.ts)에만 사용. 프로젝트 설정 > Database >
# Connection string > URI (Session pooler 권장, 예: postgresql://postgres.xxxx:[YOUR-PASSWORD]@...:5432/postgres)
SUPABASE_DB_URL=

# Google Apps Script -> /api/sync/* 호출 인증용 (sync-design.md §3)
SYNC_API_SECRET=

# Web Push VAPID 키 (push-design.md). Private Key는 서버 전용.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@linkmom.co.kr
